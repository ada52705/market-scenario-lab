<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <title>国证指数网-指数详情</title>
    <meta name="viewport" content="width=device-width,initial-scale=1,maximum-scale=1,minimum-scale=1,user-scalable=0" />
    <link type="text/css" rel="stylesheet" href="/css/common.css" />
    <link type="text/css" rel="stylesheet" href="/js/lib/element-ui/theme-chalk/index.css" />
    <link type="text/css" rel="stylesheet" href="/css/index.css" />
    <link type="text/css" rel="stylesheet" href="/css/index-detail.css" />
    <link type="text/css" rel="stylesheet" href="/font/iconfont.css" />
    <link rel="shortcut icon" type="image/x-icon" href="/image/favicon.ico" />
    <link rel="bookmark" type="image/x-icon" href="/image/favicon.ico" />
    <link type="text/css" rel="stylesheet" href="/css/mobile.css" />
    <script>
      window.isIndex = true;
    </script>
    <script type="text/javascript" async="async" src="/js/lib/datePicker.js"></script>
    <script src="/js/lib/sdkSZSE.js?v=1.0.0"></script>
    <script src="/js/lib/jsencrypt.min.js"></script>
    <script src="/js/lib/GFg2.js"></script>
    <script src="/js/lib/require.js" async="async" defer data-main="/js/pages/entry-index-detail"></script>
    <script type="text/javascript" async="async" src="/js/lib/mSlider.js"></script>
  </head>

  <body>
    <div id="index" v-cloak>
      <!-- 移动端时间插件弹窗 -->
      <div class="el-dialog__wrapper" style="z-index: 2000" v-show="mobileFullScreenDialog">
        <div class="el-dialog is-fullscreen el-dialog--center">
          <div class="el-dialog__header">
            <div class="m-dialog-title">选择时间段</div>
            <el-button
              type="danger"
              class="el-dialog__headerbtn"
              @click="mobileFullScreenDialog = false"
              icon="el-icon-close"
              circle
              size="mini"
            ></el-button>
          </div>
          <div class="el-dialog__body">
            <div class="el-col-24" style="margin-bottom: 10px">
              <el-input placeholder="开始日期" size="small" id="mChartDateStart" v-model="startAndEndTime[0]" suffix-icon="el-icon-date"></el-input>
            </div>
            <div class="el-col-24" style="margin-bottom: 10px">
              <el-input placeholder="结束日期" size="small" id="mChartDateEnd" v-model="startAndEndTime[1]" suffix-icon="el-icon-date"></el-input>
            </div>

            <div style="margin-bottom: 10px">
              <el-button type="primary" style="width: 100%" @click="changeChartDate(startAndEndTime)">确定</el-button>
            </div>

            <div>
              <el-button type="info" style="width: 100%" @click="startAndEndTime = []">取消</el-button>
            </div>
          </div>
        </div>
      </div>
      <div class="el-dialog__wrapper" style="z-index: 2000" v-show="fullScreenDialog">
        <div class="el-dialog is-fullscreen el-dialog--center">
          <div class="el-dialog__header">
            <el-button
              type="danger"
              class="el-dialog__headerbtn"
              @click="fullScreenDialog = false"
              icon="el-icon-close"
              circle
              size="mini"
            ></el-button>
          </div>
          <div class="el-dialog__body">
            <div class="sub-select-box" style="min-height: auto; z-index: 99">
              <div class="overflow-hidden">
                <div class="select-time-selection">
                  <div class="sub-title">日期区间</div>
                  <div class="sub-item" :class="item == dateOptionValue ? 'active': ''" v-for="item in dateOption" @click="changeDateOption(item)">
                    {{item}}
                  </div>
                </div>
                <div class="select-data-selection">
                  <el-date-picker
                    v-model="startAndEndTime"
                    type="daterange"
                    @change="changeChartDate"
                    style="width: 230px"
                    start-placeholder="起始日期"
                    end-placeholder="结束日期"
                    size="small"
                    :picker-options="pickOptions"
                    unlink-panels
                    value-format="yyyy-MM-dd"
                  ></el-date-picker>
                </div>
                <div class="select-chart-type" v-if="!isHsiIndex" style="float: left; margin-left: 44px">
                  <div class="float-left mr-20">
                    图表：
                    <el-dropdown @command="changeChartType">
                      <span class="el-dropdown-link">
                        {{chartTypeList[currentChartType]}}
                        <i class="el-icon-arrow-down el-icon--right"></i>
                      </span>
                      <el-dropdown-menu slot="dropdown">
                        <el-dropdown-item command="line" :disabled="isContrast">折线图</el-dropdown-item>
                        <el-dropdown-item v-if="dateOptionValue != '1D'" command="candlestick" :disabled="isContrast || realtimemarket == 0">
                          K线图
                        </el-dropdown-item>
                        <el-dropdown-item command="area" :disabled="isContrast">面积图</el-dropdown-item>
                      </el-dropdown-menu>
                    </el-dropdown>
                  </div>
                  <div class="float-left mr-20" v-if="!isHsiIndex">
                    频次：
                    <el-dropdown @command="clickChartFrequency">
                      <span class="el-dropdown-link">
                        {{chartFrequencyList[chartFrequencyType]}}
                        <i class="el-icon-arrow-down el-icon--right"></i>
                      </span>
                      <el-dropdown-menu slot="dropdown">
                        <template v-if="dateOptionValue == '1D'">
                          <el-dropdown-item command="m1">1min</el-dropdown-item>
                          <el-dropdown-item command="m15" :disabled="indexType == 700">15min</el-dropdown-item>
                          <el-dropdown-item command="m30" :disabled="indexType == 700">30min</el-dropdown-item>
                          <el-dropdown-item command="m60" :disabled="indexType == 700">60min</el-dropdown-item>
                        </template>
                        <template v-else>
                          <el-dropdown-item command="day" :disabled="isContrast || indexType == 700">日</el-dropdown-item>
                          <el-dropdown-item command="week" :disabled="isContrast || indexType == 700 || freqRange === 'day'">周</el-dropdown-item>
                          <el-dropdown-item command="month" :disabled="isContrast || indexType == 700 || freqRange === 'day' || freqRange === 'week'">
                            月
                          </el-dropdown-item>
                          <!-- <el-dropdown-item command="year" :disabled="isContrast || indexSource == 0 || indexType == 700">年</el-dropdown-item> -->
                          <!-- <el-dropdown-item command="year" :disabled="true">年</el-dropdown-item> -->
                        </template>
                      </el-dropdown-menu>
                    </el-dropdown>
                  </div>
                </div>
                <div class="select-index-more" v-if="!isHsiIndex" style="position: relative; margin-top: 0; float: left">
                  <span class="sub-title">指数对比</span>
                  <el-autocomplete
                    size="small"
                    placeholder="添加其他指数进行对比"
                    v-model="searchVal"
                    :fetch-suggestions="showKeyboardInfo"
                    style="width: 280px"
                    suffix-icon="el-icon-circle-plus-outline"
                    @select="selectOtherIndex"
                    @focus="showHotIndexBox = true"
                    @blur="blurHotIndexBox"
                  >
                    <template slot-scope="props">
                      <el-row :gutter="30">
                        <el-col :span="12">{{props.item.indexCode}}</el-col>
                        <el-col :span="12">{{props.item.shortCName}}</el-col>
                      </el-row>
                    </template>
                  </el-autocomplete>
                  <div
                    v-show="showHotIndexBox && !searchVal"
                    class="el-autocomplete-suggestion el-popper"
                    style="position: fixed; top: 108px; left: 780px; transform-origin: center top 0px; z-index: 2040; width: 300px"
                    x-placement="bottom-start"
                  >
                    <div class="el-scrollbar">
                      <div class="el-autocomplete-suggestion__wrap el-scrollbar__wrap" style="margin-bottom: -14px; margin-right: -14px">
                        <ul class="el-scrollbar__view el-autocomplete-suggestion__list" role="listbox">
                          <li role="option" v-for="item in hotIndexList">
                            <div class="el-row" style="margin-left: -15px; margin-right: -15px; position: relative" @click="selectOtherIndex(item)">
                              <div class="el-col el-col-12" style="padding-left: 15px; padding-right: 15px">{{item.indexCode}}</div>
                              <div class="el-col el-col-12" style="padding-left: 15px; padding-right: 15px">{{item.shortCName}}</div>
                            </div>
                          </li>
                        </ul>
                      </div>
                    </div>
                    <div x-arrow="" class="popper__arrow" style="left: 35px"></div>
                  </div>
                </div>
              </div>
            </div>

            <div class="stock-chart-box">
              <div id="chart2" class="chart1" style="width: 100%; height: 700px; margin-top: -85px" v-show="showStockChart"></div>
              <div class="index-list-box" v-show="contrastIndexList.length > 0">
                <div class="index-select-item">
                  <span class="ciql-color"></span>
                  <div class="sub-content-index">
                    <div>{{indexName}}</div>
                  </div>
                </div>

                <div v-for="(item,index) in contrastIndexList" class="index-select-item" @click="deleteContrastItem(index)">
                  <span class="ciql-color" :style="{backgroundColor: colors[index + 1]}"></span>
                  <div class="sub-content-index">
                    <div>{{item.shortCName}}</div>
                  </div>
                  <div class="float-left close-btn">
                    <i class="el-icon-close"></i>
                  </div>
                </div>
              </div>

              <div class="indicators-select" v-show="!isHsiIndex && contrastIndexList.length == 0 && dateOptionValue != '1D' && showStockChart">
                <el-select v-model="indicatorsValue" size="mini" @change="indicatorsChange">
                  <el-option label="MACD" value="MACD"></el-option>
                  <el-option label="BOLL" value="BOLL"></el-option>
                  <el-option label="ROC" value="ROC"></el-option>
                  <el-option label="RSI" value="RSI" :disabled="currentChartType != 'candlestick'"></el-option>
                </el-select>
              </div>

              <div class="indicators-tip" v-show="!isHsiIndex && contrastIndexList.length == 0 && dateOptionValue != '1D' && showStockChart">
                鼠标滚轮滑动放大
              </div>
            </div>
          </div>
        </div>
      </div>
      <div class="layer" v-show="isLoading">
        <div class="loading">
          <i class="loading-icon"></i>
          <span class="loading-info">页面加载中，请稍后...</span>
        </div>
      </div>
      <div class="container">
        <!-- 主体内容 -->
        <div class="content hidden-xs-only">
          <div class="wrapper" style="padding: 0">
            <div class="bread-crumb hidden-xs-only">
              <a>首页</a>
              -
              <a>指数系列</a>
              -
              <a>{{indexName}}</a>
            </div>
            <!-- 左侧 -->
            <div class="el-col el-col-xs-24 el-col-17 pd-r-10">
              <div class="chart-box bg-white">
                <div class="chart-box-head hidden-xs-only">
                  <div class="stock-name">{{indexName}}{{'（'+indexCodeName+'）'}}</div>
                  <div class="stock-detail" v-show="realtimemarket != 0 ">
                    <div class="float-left stock-detail-count" :class="[indexChg > 0 ? 'up' : 'down']">
                      {{indexCurrent}}
                      <i class="iconfont" :class="[indexChg > 0 ? 'icon-shangzhang' : 'icon-xiadie']"></i>
                    </div>
                    <div class="float-left stock-detail-item" :class="[indexChg > 0 ? 'up' : 'down']">
                      <span v-if="indexChg > 0">+</span>
                      {{indexChg}}
                    </div>
                    <div class="float-left stock-detail-item"  :class="[indexChg > 0 ? 'up' : 'down']">
                      <span v-if="indexChg > 0">+</span>
                      {{indexPercent}}%
                    </div>
                    <div class="float-left stock-detail-item" v-if="!isHsiIndex">成交额: {{indexMoney}}元</div>
                    <div class="float-left stock-detail-item">更新时间: {{indexTime}}</div>
                  </div>
                </div>
                <div class="fix-select-box hidden-xs-only" v-show="isFix">
                  <div class="wrapper">
                    <el-tabs v-model="activeName" @tab-click="mainTabClick">
                      <el-tab-pane v-for="item in tabsList" :key="item.name" :label="item.name" :name="item.id"></el-tab-pane>
                    </el-tabs>
                  </div>
                </div>
                <div class="select-box">
                  <el-tabs v-model="activeName" @tab-click="mainTabClick">
                    <el-tab-pane v-for="item in tabsList" :key="item.name" :label="item.name" :name="item.id"></el-tab-pane>
                  </el-tabs>
                  <!-- 指数表现 -->
                  <div v-show="activeName == 0" style="position: relative">
                    <div class="sub-select-box">
                      <div class="overflow-hidden">
                        <div class="select-time-selection">
                          <div class="sub-title">日期区间</div>
                          <div
                            class="sub-item"
                            :class="item == dateOptionValue ? 'active': ''"
                            v-for="item in dateOption"
                            @click="changeDateOption(item)"
                          >
                            {{item}}
                          </div>
                        </div>
                        <div class="select-data-selection">
                          <el-date-picker
                            v-model="startAndEndTime"
                            type="daterange"
                            @change="changeChartDate"
                            style="width: 230px"
                            start-placeholder="起始日期"
                            end-placeholder="结束日期"
                            size="small"
                            :picker-options="pickOptions"
                            unlink-panels
                            value-format="yyyy-MM-dd"
                          ></el-date-picker>
                        </div>
                        <div class="select-chart-type" v-if="!isHsiIndex">
                          <div class="float-left mr-20">
                            图表：
                            <el-dropdown @command="changeChartType">
                              <span class="el-dropdown-link">
                                {{chartTypeList[currentChartType]}}
                                <i class="el-icon-arrow-down el-icon--right"></i>
                              </span>
                              <el-dropdown-menu slot="dropdown">
                                <el-dropdown-item command="line" :disabled="isContrast">折线图</el-dropdown-item>
                                <el-dropdown-item v-if="dateOptionValue != '1D'" command="candlestick" :disabled="isContrast || realtimemarket == 0">
                                  K线图
                                </el-dropdown-item>
                                <el-dropdown-item command="area" :disabled="isContrast">面积图</el-dropdown-item>
                              </el-dropdown-menu>
                            </el-dropdown>
                          </div>
                          <div class="float-left" v-if="!isHsiIndex">
                            频次：
                            <el-dropdown @command="clickChartFrequency">
                              <span class="el-dropdown-link">
                                {{chartFrequencyList[chartFrequencyType]}}
                                <i class="el-icon-arrow-down el-icon--right"></i>
                              </span>
                              <el-dropdown-menu slot="dropdown">
                                <template v-if="dateOptionValue == '1D'">
                                  <el-dropdown-item command="m1">1min</el-dropdown-item>
                                  <el-dropdown-item command="m15" :disabled="indexType == 700">15min</el-dropdown-item>
                                  <el-dropdown-item command="m30" :disabled="indexType == 700">30min</el-dropdown-item>
                                  <el-dropdown-item command="m60" :disabled="indexType == 700">60min</el-dropdown-item>
                                </template>
                                <template v-else>
                                  <el-dropdown-item command="day" :disabled="isContrast || indexType == 700">日</el-dropdown-item>
                                  <el-dropdown-item command="week" :disabled="isContrast || indexType == 700 || freqRange === 'day'">
                                    周
                                  </el-dropdown-item>
                                  <el-dropdown-item
                                    command="month"
                                    :disabled="isContrast || indexType == 700 || freqRange === 'day' || freqRange === 'week'"
                                  >
                                    月
                                  </el-dropdown-item>
                                  <!-- <el-dropdown-item command="year" :disabled="isContrast || indexSource == 0 || indexType == 700">年</el-dropdown-item> -->
                                  <!-- <el-dropdown-item command="year" :disabled="true">年</el-dropdown-item> -->
                                </template>
                              </el-dropdown-menu>
                            </el-dropdown>
                          </div>
                        </div>
                      </div>

                      <div class="select-index-more" v-if="!isHsiIndex">
                        <span class="sub-title">指数对比</span>
                        <el-autocomplete
                          size="small"
                          placeholder="添加其他指数进行对比"
                          v-model="searchVal"
                          :fetch-suggestions="showKeyboardInfo"
                          style="width: 394px"
                          prefix-icon="el-icon-search"
                          @select="selectOtherIndex"
                          @focus="showHotIndexBox = true"
                          @blur="blurHotIndexBox"
                        >
                          <template slot-scope="props">
                            <el-row :gutter="30">
                              <el-col :span="12">{{props.item.indexCode}}</el-col>
                              <el-col :span="12">{{props.item.shortCName}}</el-col>
                            </el-row>
                          </template>
                        </el-autocomplete>
                        <div
                          v-show="showHotIndexBox && !searchVal"
                          class="el-autocomplete-suggestion el-popper"
                          style="position: absolute; top: 30px; left: 60px; transform-origin: center top 0px; z-index: 99999; width: 394px"
                          x-placement="bottom-start"
                        >
                          <div class="el-scrollbar">
                            <div class="el-autocomplete-suggestion__wrap el-scrollbar__wrap" style="margin-bottom: -14px; margin-right: -14px">
                              <ul class="el-scrollbar__view el-autocomplete-suggestion__list" role="listbox">
                                <li role="option" v-for="item in hotIndexList">
                                  <div
                                    class="el-row"
                                    style="margin-left: -15px; margin-right: -15px; position: relative"
                                    @click="selectOtherIndex(item)"
                                  >
                                    <div class="el-col el-col-12" style="padding-left: 15px; padding-right: 15px">{{item.indexCode}}</div>
                                    <div class="el-col el-col-12" style="padding-left: 15px; padding-right: 15px">{{item.shortCName}}</div>
                                  </div>
                                </li>
                              </ul>
                            </div>
                          </div>
                          <div x-arrow="" class="popper__arrow" style="left: 35px"></div>
                        </div>
                      </div>
                      <a type="button" class="fullscreen-btn" style="background-image: url('/image/fullscreen-btn.jpg')" @click="clickFullScreen"></a>
                    </div>

                    <div class="stock-chart-box">
                      <div id="chart1" class="chart1" style="width: 100%; height: 600px; margin-top: -85px" v-show="showStockChart"></div>
                      <div
                        style="width: 100%; height: 600px; background-image: url('/image/no-data-chart.png'); background-size: cover"
                        v-show="!showStockChart"
                      ></div>
                      <div class="index-list-box" v-show="contrastIndexList.length > 0">
                        <div class="index-select-item">
                          <span class="ciql-color"></span>
                          <div class="sub-content-index">
                            <div>{{indexName}}</div>
                          </div>
                        </div>

                        <div v-for="(item,index) in contrastIndexList" class="index-select-item" @click="deleteContrastItem(index)">
                          <span class="ciql-color" :style="{backgroundColor: colors[index + 1]}"></span>
                          <div class="sub-content-index">
                            <div>{{item.shortCName}}</div>
                          </div>
                          <div class="float-left close-btn">
                            <i class="el-icon-close"></i>
                          </div>
                        </div>
                      </div>

                      <div
                        class="indicators-select"
                        v-show="!isHsiIndex && contrastIndexList.length == 0 && dateOptionValue != '1D' && showStockChart"
                      >
                        <el-select v-model="indicatorsValue" size="mini" @change="indicatorsChange">
                          <el-option label="MACD" value="MACD"></el-option>
                          <el-option label="BOLL" value="BOLL"></el-option>
                          <el-option label="ROC" value="ROC"></el-option>
                          <el-option label="RSI" value="RSI" :disabled="currentChartType != 'candlestick'"></el-option>
                        </el-select>
                      </div>

                      <div class="indicators-tip" v-show="!isHsiIndex && contrastIndexList.length == 0 && dateOptionValue != '1D' && showStockChart">
                        鼠标滚轮滑动放大
                      </div>
                    </div>

                    <div v-if="!isHsiIndex" class="stock-table-box" style="border-bottom: 1px solid #ebeef5">
                      <el-table class="mt-20" :data="incomeList">
                        <el-table-column label="" style="font-size: 12px">
                          <el-table-column :label="incomeDate" prop="indexname"></el-table-column>
                        </el-table-column>
                        <el-table-column label="阶段性收益" align="center" cell-style="background:#000">
                          <el-table-column prop="perIncome1m" label="1M" align="center" width="69"></el-table-column>
                          <el-table-column prop="perIncome3m" label="3M" align="center" width="69"></el-table-column>
                          <el-table-column prop="perIncomeYtd" label="YTD" align="center" width="72"></el-table-column>
                        </el-table-column>
                        <el-table-column label="年化收益率" align="center">
                          <el-table-column prop="annIncome1y" label="1Y" align="center" width="72"></el-table-column>
                          <el-table-column prop="annIncome3y" label="3Y" align="center" width="70"></el-table-column>
                          <el-table-column prop="annIncome5y" label="5Y" align="center" width="70"></el-table-column>
                        </el-table-column>
                        <el-table-column label="年化波动率" align="center">
                          <el-table-column prop="annVolatility1y" label="1Y" align="center" width="80"></el-table-column>
                          <el-table-column prop="annVolatility3y" label="3Y" align="center" width="80"></el-table-column>
                          <el-table-column prop="annVolatility5y" label="5Y" align="center" width="80"></el-table-column>
                        </el-table-column>
                      </el-table>
                    </div>

                    <div style="border-bottom: 1px solid #ebeef5" v-show="indexAnalysisFlag" class="index-analysis">
                      <el-table class="mt-20" border :data="indexAnalysis">
                        <el-table-column label="计算日期" prop="genDate" align="center"></el-table-column>
                        <el-table-column label="总市值*" prop="totalMarketValue" align="center">
                          <template slot="header" slot-scope="scope">
                            <el-tooltip content="单位为亿元" effect="light" placement="top">
                              <span class="header-with-tooltip">总市值*</span>
                            </el-tooltip>
                          </template>
                        </el-table-column>
                        <el-table-column label="到期收益率" prop="yieldMaturity" align="center"></el-table-column>
                        <el-table-column label="修正久期" prop="modifiedDuration" align="center"></el-table-column>
                        <el-table-column label="凸性" prop="convexity" align="center"></el-table-column>
                        <el-table-column label="平均剩余期限" prop="avgResidualMaturity" align="center"></el-table-column>
                      </el-table>
                    </div>

                    <div class="echarts-box" v-show="(newIndexType != true && indexType != 107 && indexType != 207) && showEchart">
                      <div class="el-col-12" style="position: relative">
                        <div id="echarts1" style="height: 380px"></div>
                        <div class="update-time-left" style="left: 162px">更新时间：{{marketDate}}</div>
                      </div>
                      <div class="el-col-12" style="position: relative">
                        <div id="echarts2" style="height: 380px"></div>
                        <div class="update-time-right" style="left: 76px">更新时间：{{tradeDate}}</div>
                      </div>
                    </div>
                  </div>
                  <!-- 历史行情 -->
                  <div v-show="activeName == 1">
                    <div class="sub-select-box-md">
                      <div class="overflow-hidden">
                        <div class="select-time-selection">
                          <div class="sub-title">日期区间</div>
                          <div
                            class="sub-item"
                            :class="item == dateOptionHistory ? 'active': ''"
                            v-for="item in dateOptionPro"
                            @click="changeDateHistory(item)"
                          >
                            {{item}}
                          </div>
                        </div>
                        <div class="select-data-selection">
                          <el-date-picker
                            v-model="startAndEndTimeHistory"
                            type="daterange"
                            @change="changeHistoryDate"
                            style="width: 230px"
                            size="small"
                            :picker-options="pickOptions"
